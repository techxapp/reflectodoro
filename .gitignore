.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust/Tauri build output
/src-tauri/target

# gen/android is hand-edited (native Kotlin bridge/service/receiver code), not
# purely generated -- commit it. Other gen/<platform> dirs (e.g. a future
# gen/ios) stay ignored until they get the same treatment. Build output within
# gen/android itself is still excluded via its own nested .gitignore.
/src-tauri/gen/*
!/src-tauri/gen/android

# stray leftover file from an old npm install redirect
/src-tauri/2

# updater signing keypair -- private key must never be committed
/src-tauri/*.key
/src-tauri/*.key.pub

# Android release upload keystore -- private signing key, must never be
# committed. CI decodes it from a secret into a temp file instead (see
# .github/workflows/release.yml's android job).
*.keystore
*.jks
