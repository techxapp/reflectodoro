.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust/Tauri build output
/src-tauri/target

# gen/android (native Kotlin bridge/service/receiver code) and gen/apple (the
# iOS Xcode project, including the Live Activity widget extension) are
# hand-edited, not purely generated -- commit them. Build output within each
# is still excluded via its own nested .gitignore.
/src-tauri/gen/*
!/src-tauri/gen/android
!/src-tauri/gen/apple

# stray leftover file from an old npm install redirect
/src-tauri/2

# updater signing keypair -- private key must never be committed
/src-tauri/*.key
/src-tauri/*.key.pub

# Android release upload keystore -- private signing key, must never be
# committed. CI decodes it from a secret into a temp file instead (see
# .github/workflows/release.yml's android job).
*.keystore
*.jks

# Local-only audit/planning notes -- not meant for the repo history.
/.claude/plans/*
