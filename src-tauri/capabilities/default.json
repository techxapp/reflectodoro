{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the break overlay window, and the wellness check-in window",
  "windows": [
    "main",
    "overlay",
    "checkin"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "log:default",
    "notification:default",
    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
