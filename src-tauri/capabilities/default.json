{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the break overlay window, the startup catch-up window, and the wellness check-in window",
  "windows": [
    "main",
    "overlay",
    "catchup",
    "checkin"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:default",
    "dialog:default"
  ]
}