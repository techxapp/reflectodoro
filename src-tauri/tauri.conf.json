{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflectodoro",
  "version": "0.12.2",
  "identifier": "com.reflectodoro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Reflectodoro",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/techxapp/reflectodoro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RTU0NTE5NTUwMUJDODcKUldTSHZBRlZHVVhsZVpDRXNqTmphOHJqY0RzWGEzT3c1dENjbFMyZmdnTkJMTkpZdXYyeG85SlgK"
    }
  }
}
